# Docker Compose environment variables - copy this file to .env
# .env is gitignored and should never be committed

# Database connection (optional - defaults provided in docker-compose.yml)
DB_CONNECTION_STRING=Host=postgres;Database=myuglyrocks;Username=postgres;Password=postgres

# Redis connection (optional - defaults provided in docker-compose.yml)
REDIS_CONNECTION_STRING=redis:6379

# JWT Secret for authentication
JWT_SECRET=your-jwt-secret-here
