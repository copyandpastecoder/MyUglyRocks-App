# Copy this file to app-secrets.yaml and fill in your values
# DO NOT commit app-secrets.yaml to git!
#
# Or create the secret directly:
# kubectl create secret generic myuglyrocks-secrets --namespace myuglyrocks \
#   --from-literal=postgres-password="yourpassword" \
#   --from-literal=db-connection-string="Host=postgres;Database=myuglyrocks;Username=postgres;Password=yourpassword" \
#   --from-literal=redis-password="your-redis-password" \
#   --from-literal=jwt-secret="..." \
#   ... etc

apiVersion: v1
kind: Secret
metadata:
  name: myuglyrocks-secrets
  namespace: myuglyrocks
type: Opaque
stringData:
  # PostgreSQL password (used by postgres pod and in connection string)
  postgres-password: "yourpassword"

  # Database connection string (Host=postgres uses K8s internal DNS)
  db-connection-string: "Host=postgres;Database=myuglyrocks;Username=postgres;Password=yourpassword"

  # Redis password (required for authentication)
  redis-password: "your-redis-password"

  # Redis connection string (Host=redis uses K8s internal DNS, password included)
  redis-connection-string: "redis:6379,password=your-redis-password"

  # JWT
  jwt-secret: "your-super-secret-jwt-key-at-least-32-chars"

  # Cloudflare R2
  r2-account-id: "your-account-id"
  r2-access-key-id: "your-access-key-id"
  r2-secret-access-key: "your-secret-access-key"
  r2-bucket-name: "your-bucket-name"

  # Email (Resend)
  resend-api-key: "re_xxxxxxxxxxxx"
