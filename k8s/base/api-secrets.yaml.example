# API Secrets - Volume Mounted (More Secure)
# Copy this file to api-secrets.yaml and fill in your values
# DO NOT commit api-secrets.yaml to git!
#
# These secrets are mounted as files at /etc/secrets/ in the API container
# This is more secure than environment variables because:
# 1. Secrets don't appear in `kubectl describe pod` output
# 2. Secrets don't appear in process listings
# 3. File permissions restrict access (0400 = owner read only)
#
# Or create the secret directly:
# kubectl create secret generic myuglyrocks-api-secrets --namespace myuglyrocks \
#   --from-literal=db-connection-string="Host=postgres;Database=myuglyrocks;Username=postgres;Password=yourpassword;SSL Mode=Require;Trust Server Certificate=true" \
#   --from-literal=redis-connection-string="redis:6379,password=your-redis-password" \
#   --from-literal=jwt-secret="your-super-secret-jwt-key-at-least-32-chars" \
#   --from-literal=r2-account-id="your-account-id" \
#   --from-literal=r2-access-key-id="your-access-key-id" \
#   --from-literal=r2-secret-access-key="your-secret-access-key" \
#   --from-literal=r2-bucket-name="your-bucket-name" \
#   --from-literal=r2-public-url="https://your-r2-public-url.r2.dev" \
#   --from-literal=r2-backup-bucket-name="your-backup-bucket-name" \
#   --from-literal=resend-api-key="re_xxxxxxxxxxxx"

apiVersion: v1
kind: Secret
metadata:
  name: myuglyrocks-api-secrets
  namespace: myuglyrocks
type: Opaque
stringData:
  # Database connection string with SSL enabled
  db-connection-string: "Host=postgres;Database=myuglyrocks;Username=postgres;Password=yourpassword;SSL Mode=Require;Trust Server Certificate=true"

  # Redis connection string with password
  redis-connection-string: "redis:6379,password=your-redis-password"

  # JWT signing key (at least 32 characters)
  jwt-secret: "your-super-secret-jwt-key-at-least-32-chars"

  # Cloudflare R2 storage credentials
  r2-account-id: "your-account-id"
  r2-access-key-id: "your-access-key-id"
  r2-secret-access-key: "your-secret-access-key"
  r2-bucket-name: "your-bucket-name"
  r2-public-url: "https://your-r2-public-url.r2.dev"
  r2-backup-bucket-name: "your-backup-bucket-name"  # For database backups (optional, leave empty to disable)

  # Resend email API key
  resend-api-key: "re_xxxxxxxxxxxx"
